{
  "name": "theater-app",
  "private": true,
  "workspaces": [
    "frontend",
    "admin",
    "shared"
  ],
  "scripts": {
    "build:shared": "cd shared && npm run build:types",
    "start:admin": "cd admin && npm run tauri dev",
    "start:frontend": "cd frontend && npm run dev",
    "start:backend": "cd backend && mvn spring-boot:run",
    "lint": "npm run lint:frontend && npm run lint:admin-vue && npm run lint:admin-rust-clippy && npm run lint:shared",
    "lint:frontend": "eslint frontend/src",
    "lint:admin-vue": "eslint admin/src",
    "lint:admin-rust-clippy": "cd admin/src-tauri && cargo clippy",
    "lint:shared": "eslint shared",
    "format": "npm run format:vue && npm run format:admin-rust",
    "format:vue": "prettier --write .",
    "format:admin-rust": "cd admin/src-tauri && cargo fmt",
    "test": " npm run test:vue && npm run test:admin-rust && npm run test:backend",
    "test:vue": "vitest run",
    "test:admin-rust": "cd admin/src-tauri && cargo test",
    "test:backend": "cd backend && mvn test"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/eslint-config-prettier": "^10.0.0",
    "@vue/eslint-config-typescript": "^14.0.0",
    "@vue/test-utils": "^2.0.0",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
